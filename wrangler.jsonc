{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peek",
  "main": "src/server.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "vars": {
    // Set PUBLIC_URL to your custom domain if the embed image URLs come out wrong behind a proxy.
    // TURN: either CF_TURN_KEY_ID + CF_TURN_API_TOKEN (secret) for Cloudflare's TURN,
    // or TURN_URL + TURN_USERNAME + TURN_CREDENTIAL for any other provider.
    // Discord: set DISCORD_PUBLIC_KEY, DISCORD_BOT_TOKEN, and DISCORD_GUILD_ID
    // with `wrangler secret put` before deploying the private bot.
  }
}
